<UserControl x:Class="BiliDownloader.WinUI.Controls.DownloadResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <TextBlock Text="{Binding ResultSummary}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
        <ListView ItemsSource="{Binding Results}" SelectionMode="None" Visibility="{Binding DetailVisibility}" MaxHeight="260" AutomationProperties.Name="逐分 P 下载结果">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="4" Padding="0,4">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{Binding StatusText}"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ComboBox Header="已保存的文件" ItemsSource="{Binding OutputFiles}" SelectedItem="{Binding SelectedOutput, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="打开文件" Click="OpenFile_Click" IsEnabled="{Binding CanOpenFile}"/><Button Content="打开目录" Click="OpenFolder_Click" IsEnabled="{Binding CanOpenFolder}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="重试失败项" Click="Retry_Click" IsEnabled="{Binding CanRetry}"/>
            <Button Content="收起结果" Click="Collapse_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>

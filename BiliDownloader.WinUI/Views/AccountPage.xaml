<Page x:Class="BiliDownloader.WinUI.Views.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageContentStyle}" Width="{Binding ViewportWidth, ElementName=PageScroll}">
            <StackPanel Spacing="6">
                <TextBlock Text="账号" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="管理这台电脑上的 Bilibili 登录状态。" Style="{StaticResource SecondaryTextStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding StatusTitle}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AccountStatus"/>
                    <TextBlock Text="有任务正在使用登录态。请等待任务安全结束后再更改账号。" TextWrapping="Wrap" Visibility="{Binding TaskLockVisibility}"/>
                    <Button Content="扫码登录" Click="Login_Click" Style="{StaticResource AccentButtonStyle}" Visibility="{Binding LoginVisibility}"
                            IsEnabled="{Binding CanLogin}" AutomationProperties.AutomationId="LoginButton"/>
                    <StackPanel Visibility="{Binding QrVisibility}" Spacing="12">
                        <Grid Width="256" Height="256" HorizontalAlignment="Left">
                            <ProgressRing IsActive="{Binding IsQrLoading}" Width="36" Height="36" AutomationProperties.Name="正在生成登录二维码"/>
                            <Image Source="{Binding QrImage}" Stretch="Uniform" AutomationProperties.Name="请使用 Bilibili App 扫描的登录二维码"/>
                        </Grid>
                        <TextBlock Text="{Binding QrStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="刷新二维码" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"/>
                            <Button Content="取消登录" Click="Cancel_Click" IsEnabled="{Binding CanCancel}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ManageVisibility}" Spacing="12">
                        <Button Content="验证登录态" Click="Validate_Click" IsEnabled="{Binding CanManage}"/>
                        <Button Content="退出并清除本机登录态" Click="Clear_Click" IsEnabled="{Binding CanManage}" AutomationProperties.AutomationId="ClearLogin"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="匿名下载无需登录。登录后，可用画质仍以账号权限和平台实际返回为准。" Style="{StaticResource SecondaryTextStyle}"/>
            <Expander Header="登录与隐私" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="二维码在应用内生成，不读取浏览器 Cookie，不要求输入账号密码。手机确认后，应用会验证凭据，再使用 Windows DPAPI 加密保存在当前 Windows 用户的本机目录。" TextWrapping="Wrap"/>
                    <TextBlock Text="匿名访问不会读取已保存的凭据。应用不收集遥测，不上传链接、账号或日志。请仅下载你有权访问和保存的内容；登录不会绕过会员、付费、版权或平台限制。" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

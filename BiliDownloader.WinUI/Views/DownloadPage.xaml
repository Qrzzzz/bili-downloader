<Page x:Class="BiliDownloader.WinUI.Views.DownloadPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:BiliDownloader.WinUI.Controls" Loaded="Page_Loaded" Unloaded="Page_Unloaded" SizeChanged="Page_SizeChanged">
 <Grid Padding="24,12,24,16" RowSpacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="添加下载" Style="{StaticResource PageHeadingStyle}"/>
  <Expander Grid.Row="1" Header="{Binding InputHeading}" IsExpanded="{Binding SourceExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="SourceExpander">
   <StackPanel Spacing="8">
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="InputBox" PlaceholderText="粘贴链接、分享文本或 BV / av 号，支持多个视频" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="104" MinHeight="56" ScrollViewer.VerticalScrollBarVisibility="Auto"
      Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Input_KeyDown" IsEnabled="{Binding CanEditInput}" AutomationProperties.Name="视频链接，Enter 换行，Ctrl+Enter 解析" AutomationProperties.AutomationId="VideoInput"/>
     <Button Grid.Column="1" Content="解析链接" Click="Parse_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanParse}" AutomationProperties.AutomationId="ParseButton" ToolTipService.ToolTip="自动识别单个或多个视频。Ctrl+Enter 解析。"/>
    </Grid>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox SelectedIndex="{Binding CredentialIndex, Mode=TwoWay}" IsEnabled="{Binding CanChoose}" AutomationProperties.Name="新链接的访问方式" AutomationProperties.AutomationId="CredentialMode">
      <ComboBoxItem Content="使用本机登录态"/><ComboBoxItem Content="匿名访问"/>
     </ComboBox>
     <TextBlock Grid.Column="1" Text="{Binding AccessHint}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
   </StackPanel>
  </Expander>
  <StackPanel Grid.Row="2" Spacing="6">
   <Grid Visibility="{Binding QueueMessageVisibility}" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding QueueMessage}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <HyperlinkButton Grid.Column="1" Content="撤销移除" Click="UndoRemove_Click" Visibility="{Binding UndoVisibility}" IsEnabled="{Binding CanUndo}"/>
    <HyperlinkButton Grid.Column="2" Content="查看任务" Click="Tasks_Click" Visibility="{Binding TasksLinkVisibility}"/>
   </Grid>
   <TextBlock Text="{Binding OtherTaskStatus}" Visibility="{Binding OtherTaskVisibility}" Style="{StaticResource SecondaryTextStyle}"/>
   <Grid x:Name="ProgressCard" Visibility="{Binding ProgressVisibility}" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="4">
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" AutomationProperties.Name="解析进度" AutomationProperties.AutomationId="TaskProgress"/>
     <TextBlock Text="{Binding Metrics}" Visibility="{Binding MetricsVisibility}" TextWrapping="Wrap"/>
    </StackPanel>
    <Button Grid.Column="1" Content="{Binding CancelText}" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" AutomationProperties.AutomationId="CancelButton"/>
   </Grid>
  </StackPanel>
  <Grid x:Name="Workspace" Grid.Row="3" MinHeight="0">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*"/><ColumnDefinition x:Name="WorkspaceGap" Width="0"/><ColumnDefinition x:Name="EditorColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="BatchPanel" Visibility="{Binding BatchListVisibility}" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
     <TextBlock Text="待添加视频" Style="{StaticResource SectionHeadingStyle}"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><HyperlinkButton Content="全选" Click="SelectBatchAll_Click" IsEnabled="{Binding CanChoose}"/><HyperlinkButton Content="取消全选" Click="SelectBatchNone_Click" IsEnabled="{Binding CanChoose}"/></StackPanel>
    </StackPanel>
    <ListView x:Name="BatchList" Grid.Row="1" ItemsSource="{Binding BatchItems}" SelectionMode="None" IsEnabled="{Binding CanChoose}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="待添加的视频" AutomationProperties.AutomationId="BatchList">
     <ListView.ItemTemplate><DataTemplate>
      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" MinWidth="0" Width="32" Padding="0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}"/>
        <StackPanel Grid.Column="1" Spacing="4">
         <TextBlock Text="正在编辑" Visibility="{Binding EditingVisibility}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
         <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding Title}"/>
         <TextBlock Text="{Binding ConfigurationSummary}" Style="{StaticResource SecondaryTextStyle}" ToolTipService.ToolTip="{Binding ConfigurationDetail}"/>
         <TextBlock Text="{Binding ValidationMessage}" Visibility="{Binding ValidationVisibility}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
         <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="配置" Click="ConfigureBatch_Click" Visibility="{Binding ConfigureVisibility}"/>
          <Button Content="重试解析" Click="RetryBatch_Click" Visibility="{Binding RetryVisibility}"/>
          <Button Content="移除" Click="RemoveBatch_Click" ToolTipService.ToolTip="从待添加列表移除，不影响已入队的任务。"/>
         </StackPanel>
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
   <ScrollViewer x:Name="EditorScroll" Visibility="{Binding EditorVisibility}" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <StackPanel x:Name="VideoCard" Spacing="12" Padding="0,0,8,8">
     <HyperlinkButton Content="返回列表" Click="BackToBatch_Click" Visibility="{Binding BackVisibility}"/>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Width="96" Height="60" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="视频封面"/>
      <StackPanel Grid.Column="1" Spacing="4">
       <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       <TextBlock Text="{Binding Metadata}" Style="{StaticResource SecondaryTextStyle}"/>
      </StackPanel>
      <Button Grid.Column="2" Content="更多" VerticalAlignment="Top" Visibility="{Binding BatchVisibility}" IsEnabled="{Binding CanResetBatch}">
       <Button.Flyout><MenuFlyout>
        <MenuFlyoutItem Text="将规格用于其他未单独修改的项目" Click="ApplyBatchDefaults_Click"/>
        <MenuFlyoutItem Text="此项恢复本批次默认规格" Click="ResetBatchDraft_Click"/>
       </MenuFlyout></Button.Flyout>
      </Button>
     </Grid>
     <Expander Header="{Binding SelectionSummary}" Visibility="{Binding PartsVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
       <ListView x:Name="PartsList" ItemsSource="{Binding Parts}" SelectionMode="Multiple" SelectionChanged="Parts_SelectionChanged" IsEnabled="{Binding CanEditSpecification}" MaxHeight="180" AutomationProperties.Name="分 P 列表" AutomationProperties.AutomationId="PartsList">
        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全选" Click="SelectAll_Click" IsEnabled="{Binding CanEditSpecification}"/><Button Content="清空选择" Click="SelectNone_Click" IsEnabled="{Binding CanEditSpecification}"/></StackPanel>
      </StackPanel>
     </Expander>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="ModeField" Header="下载内容" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditSpecification}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DownloadMode">
       <ComboBoxItem Content="视频 MP4"/><ComboBoxItem Content="音频 MP3 · 192 kbps"/>
      </ComboBox>
      <ComboBox x:Name="FormatField" Grid.Column="1" Header="画质" ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" Visibility="{Binding FormatVisibility}" IsEnabled="{Binding CanEditSpecification}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VideoFormat"/>
     </Grid>
     <TextBlock Text="{Binding QualityHint}" Visibility="{Binding FormatVisibility}" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="QualityPreferenceHint"/>
     <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox Header="保存到" Text="{Binding DownloadDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSpecification}" AutomationProperties.AutomationId="DownloadDirectory"/>
      <Button Grid.Column="1" Content="浏览…" Click="Browse_Click" IsEnabled="{Binding CanEditSpecification}" VerticalAlignment="Bottom" AutomationProperties.Name="选择下载目录"/>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer Grid.ColumnSpan="3" Visibility="{Binding ResultVisibility}"><views:DownloadResultView x:Name="ResultCard" AutomationProperties.AutomationId="DownloadResult"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding SubmissionHint}" TextWrapping="Wrap" Visibility="{Binding SingleSubmitVisibility}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding BatchSummary}" TextWrapping="Wrap" Visibility="{Binding BatchSubmitVisibility}"/>
    </StackPanel>
    <HyperlinkButton Grid.Column="1" Content="诊断日志" Click="Logs_Click" Visibility="{Binding LogsVisibility}"/>
    <Button Grid.Column="2" Content="加入队列" Click="Download_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanDownload}" Visibility="{Binding SingleSubmitVisibility}" AutomationProperties.AutomationId="DownloadButton"/>
    <Button Grid.Column="2" Content="{Binding BatchSubmitText}" Click="AddBatch_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanAddBatch}" Visibility="{Binding BatchSubmitVisibility}" AutomationProperties.AutomationId="AddBatch"/>
    <Button Grid.Column="2" Content="完成配置" Click="BackToBatch_Click" Visibility="{Binding BackVisibility}"/>
   </Grid>
  </Border>
 </Grid>
</Page>

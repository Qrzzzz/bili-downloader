<Page x:Class="BiliDownloader.WinUI.Views.DownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="using:BiliDownloader.WinUI.Controls"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="24" MaxWidth="1080" HorizontalAlignment="Stretch">
            <TextBlock Text="下载" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBox x:Name="InputBox" Header="视频链接或 BV / av 号" PlaceholderText="https://www.bilibili.com/video/…"
                     Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown"
                     AutomationProperties.AutomationId="VideoInput"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="解析" Click="Parse_Click" IsEnabled="{Binding CanParse}" AutomationProperties.AutomationId="ParseButton"/>
                <ComboBox SelectedIndex="{Binding CredentialIndex, Mode=TwoWay}" IsEnabled="{Binding CanChoose}" AutomationProperties.Name="访问方式">
                    <ComboBoxItem Content="使用本机登录态"/><ComboBoxItem Content="匿名访问"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Visibility="{Binding VideoVisibility}" Spacing="16">
                <Image Source="{Binding Thumbnail}" MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="视频封面"/>
                <TextBlock Text="{Binding Title}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <TextBlock Text="{Binding Metadata}" TextWrapping="Wrap"/>
                <StackPanel Visibility="{Binding PartsVisibility}" Spacing="8">
                    <TextBlock Text="选择分 P" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <ListView x:Name="PartsList" ItemsSource="{Binding Parts}" DisplayMemberPath="Label" SelectionMode="Multiple"
                              SelectionChanged="Parts_SelectionChanged" IsEnabled="{Binding CanChoose}" MaxHeight="240" AutomationProperties.Name="分 P 列表"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="全选" Click="SelectAll_Click" IsEnabled="{Binding CanChoose}"/><Button Content="清空选择" Click="SelectNone_Click" IsEnabled="{Binding CanChoose}"/>
                    </StackPanel>
                </StackPanel>
                <ComboBox Header="下载内容" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="音视频（MP4）"/><ComboBoxItem Content="仅音频（MP3，192 kbps）"/>
                </ComboBox>
                <ComboBox Header="画质" ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                          Visibility="{Binding FormatVisibility}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Stretch"/>
                <TextBox Header="保存目录" Text="{Binding DownloadDirectory, Mode=TwoWay}" IsEnabled="{Binding CanChoose}" AutomationProperties.AutomationId="DownloadDirectory"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="选择目录" Click="Browse_Click" IsEnabled="{Binding CanChoose}"/>
                    <Button Content="开始下载" Click="Download_Click" IsEnabled="{Binding CanDownload}" AutomationProperties.AutomationId="DownloadButton"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{Binding ProgressVisibility}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" AutomationProperties.Name="下载进度"/>
                <TextBlock Text="{Binding Metrics}" TextWrapping="Wrap"/>
                <Button Content="取消当前任务" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" AutomationProperties.AutomationId="CancelButton"/>
            </StackPanel>
            <views:DownloadResultView Visibility="{Binding ResultVisibility}"/>
            <Expander Header="任务日志" HorizontalAlignment="Stretch">
                <TextBox Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="240" AutomationProperties.Name="脱敏任务日志"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

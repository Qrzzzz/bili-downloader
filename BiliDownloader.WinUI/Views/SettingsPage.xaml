<Page x:Class="BiliDownloader.WinUI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource PageContentStyle}" Width="{Binding ViewportWidth, ElementName=PageScroll}">
            <StackPanel Spacing="6">
                <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="调整外观、保存位置，或检查运行环境。" Style="{StaticResource SecondaryTextStyle}"/>
            </StackPanel>
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <ComboBox Header="外观" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ThemePreference">
                        <ComboBoxItem Content="跟随 Windows"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
                    </ComboBox>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Header="默认下载目录" Text="{Binding DownloadDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="DefaultDirectory"/>
                        <Button Grid.Column="1" Content="浏览…" Click="Browse_Click" IsEnabled="{Binding CanEdit}" VerticalAlignment="Bottom" AutomationProperties.Name="选择默认下载目录"/>
                    </Grid>
                    <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite"/>
                    <Button Content="保存设置" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="SaveSettings"/>
                </StackPanel>
            </Border>
            <Expander Header="环境诊断" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="检查下载组件、FFmpeg 和保存目录。请自行准备 FFmpeg，应用不会自动下载或捆绑它。" TextWrapping="Wrap"/>
                    <Button Content="运行诊断" Click="Diagnose_Click" IsEnabled="{Binding CanManage}"/>
                    <ListView ItemsSource="{Binding Diagnostics}" SelectionMode="None" AutomationProperties.Name="环境诊断结果">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,4">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}"/>
                        </StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="复制脱敏诊断" Click="Copy_Click" IsEnabled="{Binding CanCopyDiagnostics}"/>
                        <Button Content="打开日志目录" Click="Logs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander Header="关于与更新" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="Bili Downloader Lite 2.7" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="检查更新" Click="Update_Click" IsEnabled="{Binding CanManage}"/>
                        <Button Content="打开发行页面" Click="Release_Click"/>
                    </StackPanel>
                    <TextBlock Text="仅在点击“检查更新”时访问 GitHub。下载与登录凭据保存在本机。" Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

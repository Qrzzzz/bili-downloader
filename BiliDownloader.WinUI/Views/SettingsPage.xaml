<Page x:Class="BiliDownloader.WinUI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>
            <ComboBox Header="外观" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="跟随 Windows"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
            </ComboBox>
            <TextBox Header="默认下载目录" Text="{Binding DownloadDirectory, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="选择目录" Click="Browse_Click" IsEnabled="{Binding CanSave}"/>
                <Button Content="保存设置" Click="Save_Click" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="SaveSettings"/>
            </StackPanel>
            <Expander Header="环境诊断" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="检查 Python、yt-dlp、二维码组件、FFmpeg 和目录。FFmpeg 由你自行准备，应用不会下载或捆绑它。" TextWrapping="Wrap"/>
                    <Button Content="运行诊断" Click="Diagnose_Click" IsEnabled="{Binding CanManage}"/>
                    <ListView ItemsSource="{Binding Diagnostics}" SelectionMode="None" AutomationProperties.Name="环境诊断结果">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,4">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                        </StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Button Content="复制脱敏诊断" Click="Copy_Click"/>
                    <Button Content="打开日志目录" Click="Logs_Click"/>
                </StackPanel>
            </Expander>
            <Expander Header="关于与更新" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="Bili Downloader Lite 2.5"/>
                    <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap"/>
                    <Button Content="检查更新" Click="Update_Click" IsEnabled="{Binding CanManage}"/>
                    <Button Content="打开发行页面" Click="Release_Click"/>
                    <TextBlock Text="仅在点击“检查更新”时访问 GitHub。下载与登录凭据保存在本机。" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

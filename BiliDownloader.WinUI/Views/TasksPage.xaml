<Page x:Class="BiliDownloader.WinUI.Views.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Padding="24" RowSpacing="12" MaxWidth="960" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="任务" Style="{StaticResource PageHeadingStyle}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="TaskSummary"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" AutomationProperties.Name="任务状态筛选">
                <ComboBoxItem Content="全部"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/><ComboBoxItem Content="需处理"/>
            </ComboBox>
            <Button Grid.Column="1" Content="{Binding PauseText}" Click="Pause_Click" IsEnabled="{Binding CanManage}" AutomationProperties.AutomationId="PauseQueue" ToolTipService.ToolTip="暂停后，正在执行的任务仍会安全完成。"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource SurfaceCardStyle}" Visibility="{Binding EmptyVisibility}" VerticalAlignment="Top" Padding="20,16">
                <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="360">
                    <FontIcon Glyph="&#xE896;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <ListView ItemsSource="{Binding Items}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="TaskList" AutomationProperties.Name="下载任务">
                <ListView.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" MaxWidth="100" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                            <TextBlock Text="{Binding Specification}" Style="{StaticResource SecondaryTextStyle}"/>
                            <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Visibility="{Binding ProgressVisibility}" AutomationProperties.Name="此任务进度"/>
                            <TextBlock Text="{Binding Metrics}" Visibility="{Binding MetricsVisibility}" Style="{StaticResource SecondaryTextStyle}"/>
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Visible" AutomationProperties.Name="任务操作">
                                <AppBarButton Label="打开文件" Icon="OpenFile" Click="OpenOutput_Click" Visibility="{Binding OpenVisibility}" IsEnabled="{Binding CanInspect}"/>
                                <AppBarButton Label="取消任务" Icon="Cancel" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Visibility="{Binding CancelVisibility}"/>
                                <AppBarButton Label="重试失败项" Icon="Refresh" Click="Retry_Click" IsEnabled="{Binding CanRetry}" Visibility="{Binding RetryVisibility}"/>
                                <AppBarButton Label="{Binding DetailButtonText}" Icon="View" Click="Details_Click" AutomationProperties.AutomationId="TaskDetailsToggle"/>
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Label="打开目录" Click="Folder_Click" IsEnabled="{Binding CanOpenFolder}"/>
                                    <AppBarButton Label="继续未完成项" Click="Resume_Click" IsEnabled="{Binding CanResume}" Visibility="{Binding ResumeVisibility}"/>
                                    <AppBarButton Label="确认使用当前账号并继续" Click="Reauthorize_Click" IsEnabled="{Binding CanResume}" Visibility="{Binding ReauthorizeVisibility}"/>
                                    <AppBarButton Label="移到队首" Click="First_Click" IsEnabled="{Binding CanReorder}" Visibility="{Binding ReorderVisibility}"/>
                                    <AppBarButton Label="查看日志" Click="Logs_Click" IsEnabled="{Binding CanInspect}"/>
                                    <AppBarButton Label="移除记录" Click="Remove_Click" IsEnabled="{Binding CanRemove}" Visibility="{Binding RemoveVisibility}" ToolTipService.ToolTip="只移除记录，保留下载文件。"/>
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <StackPanel Visibility="{Binding DetailVisibility}" Spacing="8" AutomationProperties.AutomationId="TaskDetails">
                                <TextBlock Text="保存位置" Style="{StaticResource SecondaryTextStyle}"/>
                                <TextBlock Text="{Binding Directory}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <Button Content="打开目录" Click="Folder_Click" IsEnabled="{Binding CanOpenFolder}"/>
                                <TextBlock Text="{Binding Details}" Visibility="{Binding IssuesVisibility}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <ItemsControl ItemsSource="{Binding Files}" HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid ColumnSpacing="8" Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Path}"/>
                                            <Button Grid.Column="1" Content="打开" Click="OutputFile_Click" AutomationProperties.Name="{Binding Name}"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="查看日志" Click="Logs_Click" IsEnabled="{Binding CanInspect}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="1" Content="清理已完成记录" Click="Clear_Click" Margin="0,12,0,0" IsEnabled="{Binding CanClearCompleted}" Visibility="{Binding ClearVisibility}" ToolTipService.ToolTip="只清理任务记录，保留已下载的文件。"/>
        </Grid>
    </Grid>
</Page>
